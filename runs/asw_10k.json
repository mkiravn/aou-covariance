{
  "run_id": "asw_10k",
  "root": "~/aucov_runs/asw_10k",
  "params": {
    "simulated": false,
    "mirror": "gs://cloned-shared-env-pilot-wb-swift-sprout-7231/phenotypic_covariance_v9/aucov_across_pops/asw_10k",
    "scratch": "~/aucov_scratch",
    "inputs": {
      "ancestry_preds": "~/workspace/cdrv9/vwb-aou-datasets-controlled-v9/v9/wgs/short_read/snpindel/aux/ancestry/ancestry_preds.tsv",
      "training_pca": "~/workspace/cdrv9/vwb-aou-datasets-controlled-v9/v9/wgs/short_read/snpindel/aux/ancestry/training_pca.tsv",
      "relatedness": "~/workspace/cdrv9/vwb-aou-datasets-controlled-v9/v9/wgs/short_read/snpindel/aux/relatedness/samples_relatedness.tsv",
      "acaf_pfile": "~/workspace/cdrv9/vwb-aou-datasets-controlled-v9/v9/wgs/short_read/snpindel/acaf_threshold/pgen/acaf_threshold.chr{chr}",
      "ref_bfile": "~/workspace/Data from All of Us Controlled Tier /shared-env-pilot/1000g_reference/1kg_all_qc",
      "ref_labels": "~/workspace/Data from All of Us Controlled Tier /shared-env-pilot/reference_labels/20130606_g1k_3202_samples_ped_population.txt",
      "hm3_ids": "~/aucov_runs/chb_chs/diagnostics/hm3_ids_matched.txt",
      "phenotype_tables": "TODO: folder of {phenotype}.tsv (person_id, phenotype, age, sex_at_birth) pulled for the whole cohort",
      "phenotype_list": "docs/phenotype_list.tsv",
      "ld_regions": "resources/high_ld_regions_hg38.txt",
      "hm3_rsids": "gs://cloned-shared-env-pilot-wb-swift-sprout-7231/1000g_reference/hm3.snplist",
      "ref_pvar_rsid": "https://www.dropbox.com/scl/fi/id642dpdd858uy41og8qi/all_hg38_rs_noannot.pvar.zst?rlkey=sskyiyam1bsqweujjmxqv1h55&dl=1",
      "acaf_pfile_gs": "gs://vwb-aou-datasets-controlled/v9/wgs/short_read/snpindel/acaf_threshold/pgen/acaf_threshold.chr{chr}",
      "phased_vcf": "~/workspace/cdrv9/vwb-aou-datasets-controlled-v9/v9/wgs/short_read/snpindel/aux/phasing/chr{chr}.aou.v9.phased.filtered.vcf.bgz",
      "genetic_map": "https://bochet.gcc.biostat.washington.edu/beagle/genetic_maps/plink.GRCh38.map.zip",
      "phased_vcf_gs": "gs://vwb-aou-datasets-controlled/v9/wgs/short_read/snpindel/aux/phasing/chr{chr}.aou.v9.phased.filtered.vcf.bgz"
    },
    "tools": {
      "plink2": "~/bin/plink2",
      "plink": "~/bin/plink",
      "grm_class_tool": "src/grm_class_tool",
      "ilash": "~/bin/ilash"
    },
    "threads": 62,
    "superpop": "AFR",
    "r1_n_pcs": 5,
    "r1_width": 0.99,
    "qc_maf": 0.01,
    "qc_hwe": 1e-06,
    "qc_geno": 0.05,
    "target_pops": [
      "ASW"
    ],
    "r2_n_pcs_fit": 10,
    "r2_k": 4,
    "r2_q": 0.999,
    "cov_n_pcs": 10,
    "cov_r2": 0.1,
    "cov_kin_cut": 0.1,
    "pcr_n_pcs": 4,
    "bins": {
      "fine": 0.001,
      "mid": 0.005,
      "coarse": 0.01
    },
    "outlier_sd": 5,
    "seed": 1,
    "n_shards": 60,
    "nblocks": 50,
    "billing_project": "wb-swift-sprout-7231",
    "backend": "dsub",
    "dsub": {
      "project": "wb-swift-sprout-7231",
      "region": "us-central1",
      "service_account": "pet-27799165194323faf22e2@wb-swift-sprout-7231.iam.gserviceaccount.com",
      "cloud_sdk_tag": "581.0.0-slim",
      "machine_type": "n1-standard-8",
      "threads": 8,
      "logging": "gs://cloned-shared-env-pilot-wb-swift-sprout-7231/phenotypic_covariance_v9/aucov_across_pops/dsub_logs",
      "plink2": "gs://cloned-shared-env-pilot-wb-swift-sprout-7231/phenotypic_covariance_v9/aucov_across_pops/bin/plink2"
    },
    "dsub_phased": {
      "machine_type": "n1-standard-16",
      "threads": 16,
      "preemptible": true
    },
    "subsample_of": "asw",
    "subsample_n": 10000,
    "parent_root": "/home/jupyter/aucov_runs/asw"
  },
  "lists": {
    "phenotypes": [
      "height",
      "bmi"
    ],
    "transforms": [
      "raw",
      "invnorm"
    ],
    "covsets": [
      "base",
      "base_pcs"
    ]
  },
  "stages": {
    "ancestry_round1": {
      "description": "asw's (shared, not remade here): ellipsoid on AoU's premade PCs around a 1000G superpopulation",
      "dir": "{parent_root}/ancestry/round1",
      "pattern": "keep.txt"
    },
    "acaf_hm3": {
      "description": "ACAF cut to HapMap3 for everyone, multi-allelic rows split, IDs chr:pos:ref:alt; once per CDR, shared by every run",
      "dir": "gs://cloned-shared-env-pilot-wb-swift-sprout-7231/phenotypic_covariance_v9/aucov_across_pops/acaf_hm3",
      "pattern": "hm3.chr{chr}.pgen",
      "over": {
        "chr": 22
      },
      "needs": []
    },
    "hm3_panel": {
      "description": "asw's (shared, not remade here): HapMap3 SNPs, QC'd in the round-1 set, matched to the reference, no A/T or C/G",
      "dir": "{parent_root}/panels",
      "pattern": "hm3_round1.bed",
      "needs": [
        "ancestry_round1",
        "acaf_hm3"
      ]
    },
    "round2_pca": {
      "description": "asw's (shared, not remade here): PCA on the 1000G superpopulation (bed_autoSVD), round-1 set projected by OADP; gate to target_pops",
      "dir": "{parent_root}/ancestry/round2",
      "pattern": "scores.tsv",
      "needs": [
        "hm3_panel"
      ]
    },
    "ancestry_round2": {
      "description": "uniform random subsample_n of asw's final set (subsample notebook)",
      "dir": "ancestry/round2",
      "pattern": "keep.txt",
      "needs": [
        "round2_pca"
      ]
    },
    "covariate_pcs": {
      "description": "PCs fit on the unrelated part of the final set, everyone else projected",
      "dir": "covariates",
      "pattern": "pcs.tsv",
      "needs": [
        "ancestry_round2",
        "hm3_panel"
      ]
    },
    "grm_panel": {
      "description": "HapMap3 SNPs QC'd within the final set, ~1e6 on the Workbench",
      "dir": "grm/input",
      "pattern": "panel.bed",
      "needs": [
        "ancestry_round2",
        "acaf_hm3"
      ]
    },
    "grm_shards": {
      "description": "plink 1.9 --make-grm-bin --parallel i n",
      "dir": "grm/shards",
      "pattern": "grm.shard{i}.grm.bin.{i}",
      "over": {
        "i": "$n_shards"
      },
      "needs": [
        "grm_panel"
      ]
    },
    "pcrelate": {
      "description": "PC-Relate kinship on the GRM panel, allele frequencies from the covariate PCs; lower triangle, GCTA order",
      "dir": "pcrelate",
      "pattern": "kinship.bin",
      "needs": [
        "grm_shards",
        "covariate_pcs"
      ]
    },
    "phenotypes": {
      "description": "plausible range, residualise, 5 SD trim, standardise within sex",
      "dir": "phenotypes",
      "pattern": "{pheno}__{transform}__{covset}.pheno",
      "over": {
        "pheno": "@phenotypes",
        "transform": "@transforms",
        "covset": "@covsets"
      },
      "needs": [
        "ancestry_round2",
        "covariate_pcs"
      ]
    },
    "crossproducts": {
      "description": "grm_class_tool accumulate, all phenotype combos in one pass per shard",
      "dir": "crossproducts/shards",
      "pattern": "shard{i}.index.tsv",
      "over": {
        "i": "$n_shards"
      },
      "needs": [
        "grm_shards",
        "phenotypes"
      ]
    },
    "merged": {
      "description": "grm_class_tool merge, one table per combo",
      "dir": "crossproducts/merged",
      "pattern": "{pheno}__{transform}__{covset}.full.tsv",
      "over": {
        "pheno": "@phenotypes",
        "transform": "@transforms",
        "covset": "@covsets"
      },
      "needs": [
        "crossproducts"
      ]
    },
    "curves": {
      "description": "binned covariance curves and the estimator ladder",
      "dir": "curves",
      "pattern": "estimates.tsv",
      "needs": [
        "merged"
      ]
    },
    "hm3_overlap": {
      "description": "diagnostic: HapMap3 from the rsID list to the QC'd panel, step by step",
      "dir": "diagnostics",
      "pattern": "hm3_overlap.tsv"
    },
    "phased_hm3": {
      "description": "AoU phased callset cut to HapMap3 for everyone (PASS, multi-allelic split, IDs chr:pos:ref:alt), phase kept; once per CDR, shared by every run",
      "dir": "gs://cloned-shared-env-pilot-wb-swift-sprout-7231/phenotypic_covariance_v9/aucov_across_pops/phased_hm3",
      "pattern": "phased.chr{chr}.pgen",
      "over": {
        "chr": 22
      },
      "needs": []
    },
    "ilash": {
      "description": "iLASH IBD segments in the final set (phased callset x HapMap3); per pair: segments, total cM, IBD kinship",
      "dir": "ilash",
      "pattern": "pairs.tsv",
      "needs": [
        "ancestry_round2",
        "phased_hm3"
      ]
    }
  }
}
